#!/usr/bin/env sh

branch="$(git rev-parse --abbrev-ref HEAD)"
protected_branches="main dev staging production prod"

for protected in $protected_branches; do
  if [ "$branch" = "$protected" ]; then
    echo "❌ Direct commits to '$protected' are not allowed."
    echo " Please create a feature/fix/chore branch."
    exit 1
  fi
done

echo '��� Checking code formatting...'
pnpm format:check ||
(
    echo '❌ Prettier check failed!'
    echo '��� Run: pnpm format'
    echo ''
    exit 1
)

echo '��� Running ESLint...'
pnpm lint ||
(
    echo '❌ ESLint check failed!'
    echo '��� Fix the errors above or run: pnpm lint:fix'
    echo ''
    exit 1
)

echo '��� Checking TypeScript types...'
pnpm typecheck ||
(
    echo '❌ TypeScript check failed!'
    echo '��� Fix the type errors above'
    echo ''
    exit 1
)

echo '✅ All pre-commit checks passed!'
